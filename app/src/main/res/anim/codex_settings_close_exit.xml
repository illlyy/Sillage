<?xml version="1.0" encoding="utf-8"?>
<!-- Used when the settings window closes on Android 14+. The predictive-back handoff has
     already swept the page off-screen, so the window only holds the captured chat preview.
     A short fade keeps that preview on screen while the paused chat window underneath
     resumes and draws its first frame, instead of exposing a one-frame gap. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="140"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
