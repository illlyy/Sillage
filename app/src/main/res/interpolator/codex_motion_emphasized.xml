<?xml version="1.0" encoding="utf-8"?>
<!-- Emphasized deceleration curve (fast launch, long gentle settle) shared by the
     chat <-> settings Activity transitions so they read as one physical motion. -->
<pathInterpolator xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.2"
    android:controlY1="0"
    android:controlX2="0"
    android:controlY2="1" />
